{
  "operationId": "createBook",
  "successStatus": 201,
  "sources": {
    "book": {
      "type": "sql",
      "connection": "library_db",
      "script": "create_book.sql",
      "cardinality": "one",
      "onError": 500,
      "parameters": [
        {
          "name": "title",
          "from": "body.title"
        },
        {
          "name": "author",
          "from": "body.author"
        },
        {
          "name": "isbn",
          "from": "body.isbn"
        }
      ]
    }
  },
  "response": {
    "id": {
      "from": "sources.book.id",
      "format": "integer"
    },
    "title": "sources.book.title",
    "author": "sources.book.author",
    "isbn": "sources.book.isbn",
    "available": {
      "from": "sources.book.available",
      "format": "boolean"
    },
    "deleted": {
      "from": "sources.book.deleted",
      "format": "boolean"
    }
  }
}